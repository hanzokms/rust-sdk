# Hanzo KMS SDK Configuration
# Copy this file to .env and fill in your actual values

# Your Hanzo KMS client ID (from universal auth machine identity)
KMS_CLIENT_ID=your_client_id_here

# Your Hanzo KMS client secret (from universal auth machine identity)
KMS_CLIENT_SECRET=your_client_secret_here

# Your Hanzo KMS project ID for secrets management
KMS_SECRETS_PROJECT_ID=your_project_id_here

# Your Hanzo KMS project ID for KMS
KMS_KMS_PROJECT_ID=your_project_id_here

# Optional: Hanzo KMS base URL (defaults to http://localhost:8080 in tests)
# KMS_BASE_URL=https://kms.hanzo.ai
